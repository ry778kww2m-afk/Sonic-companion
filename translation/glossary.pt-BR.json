{
  "version": "sonic-musical-glossary-ptbr-1.0.0",
  "locale": "pt-BR",
  "purpose": "Editorial reference for maintaining consistent Brazilian Portuguese musical terminology when new translation-memory entries are authored. These terms are not blindly substituted into unknown prose.",
  "terms": {
    "ride cymbal": {"preferred": "prato de condução", "note": "Jazz drum-kit vocabulary."},
    "hi-hat": {"preferred": "chimbal", "note": "Distinguish from the ride cymbal."},
    "snare drum": {"preferred": "caixa", "note": "Drum-kit instrument."},
    "kick drum": {"preferred": "bumbo", "note": "Drum-kit instrument."},
    "brushes": {"preferred": "vassourinhas", "note": "Jazz percussion technique."},
    "double bass": {"preferred": "contrabaixo acústico", "note": "Use baixo acústico where the sentence needs a shorter form."},
    "bass line": {"preferred": "linha de baixo", "note": "Do not confuse with the bass instrument itself."},
    "walking bass": {"preferred": "walking bass", "alternative": "linha de baixo caminhante", "note": "Keep the jazz idiom; never render as literal walking."},
    "head (jazz)": {"preferred": "tema", "note": "The composed theme played before/after solos."},
    "chorus (jazz form)": {"preferred": "chorus", "alternative": "uma passagem completa pela forma", "note": "Not a pop-song refrain."},
    "changes (jazz)": {"preferred": "mudanças harmônicas", "alternative": "progressão harmônica", "note": "Usually refers to the chord progression."},
    "comping": {"preferred": "acompanhamento em acordes", "alternative": "comping", "note": "Context may justify retaining the English jazz term."},
    "voicing": {"preferred": "disposição dos acordes", "alternative": "abertura dos acordes", "note": "Choose according to whether chord spacing/arrangement is meant."},
    "inner voices": {"preferred": "vozes internas", "note": "Polyphonic/keyboard texture."},
    "call and response": {"preferred": "pergunta e resposta", "note": "Musical exchange between voices/sections."},
    "backbeat": {"preferred": "acentuação nos tempos 2 e 4", "note": "Explain the beats when useful."},
    "horn section": {"preferred": "naipe de sopros", "note": "Includes saxophones where applicable."},
    "brass": {"preferred": "metais", "note": "Do not use for all woodwind/saxophone parts."},
    "woodwinds": {"preferred": "madeiras", "note": "Orchestral family."},
    "pizzicato": {"preferred": "pizzicato", "note": "Retain the conventional Italian technique name."},
    "bowed": {"preferred": "com arco", "note": "Describe the string-playing technique."},
    "cantabile": {"preferred": "cantabile", "note": "Can be glossed as canto/linha cantante when needed."},
    "ostinato": {"preferred": "ostinato", "note": "Repeated musical pattern."},
    "groove": {"preferred": "groove", "note": "Common musician usage; do not flatten into generic rhythm."},
    "swing": {"preferred": "swing", "note": "Retain the established jazz term."},
    "riff": {"preferred": "riff", "note": "Short recurring musical idea."},
    "rubato": {"preferred": "rubato", "note": "Retain the established performance term."},
    "counterpoint": {"preferred": "contraponto", "note": "Independent melodic lines in relation."},
    "sonata form": {"preferred": "forma-sonata", "note": "Classical formal term."},
    "exposition": {"preferred": "exposição", "note": "In formal analysis."},
    "development": {"preferred": "desenvolvimento", "note": "In formal analysis."},
    "recapitulation": {"preferred": "recapitulação", "note": "In formal analysis."},
    "coda": {"preferred": "coda", "note": "Retain the established musical term."},
    "anacrusis": {"preferred": "anacruse", "note": "Upbeat/pickup before the first strong beat."},
    "pedal point": {"preferred": "nota pedal", "note": "Sustained/repeated harmonic foundation."},
    "fortspinnung": {"preferred": "fortspinnung", "note": "Retain the historical/theoretical term and explain only where needed."}
  }
}
